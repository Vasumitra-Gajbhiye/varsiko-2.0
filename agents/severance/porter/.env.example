# Severance Porter — no vendor API key of its own.
# Copy to .env; .env is gitignored by the repo-root rule.

# Optional. GitHub PAT with `repo` read scope, used only to fetch a repo tarball
# in the A2A lane. Public repos work without it but hit the 60/hr anon rate limit.
GITHUB_TOKEN=

# 1 = use bundled fixtures, never fetch a repo over the network.
# WARNING: unset means LIVE. Keep this at 1 unless you mean to hit GitHub.
PORTER_OFFLINE=1

# 1 = actually write transformed files into the target repo. Leave unset for a dry run.
PORTER_APPLY=

# A2A server port.
PORT=8000
