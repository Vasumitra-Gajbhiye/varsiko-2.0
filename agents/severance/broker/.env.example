# Secrets — never commit real values.
# nasiko secrets set ANAKIN_API_KEY         <value> --agent severance-broker
# nasiko secrets set MANDATE_SIGNING_SECRET <32-byte hex> --agent severance-broker
# The Pilot must get the SAME MANDATE_SIGNING_SECRET as an agent-scoped secret, not vault-wide.
ANAKIN_API_KEY=
MANDATE_SIGNING_SECRET=
ANTHROPIC_API_KEY=

# LLM: Nasiko gateway first (injected at deploy). Anthropic is the local fallback.
# OPENAI_BASE_URL=
# OPENAI_API_KEY=
# MCP_GATEWAY_URL=
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
MODEL=deepseek-v4-flash

# Pinned FX — never fetch a live rate mid-run.
FX_EUR_INR=94.2
FX_USD_INR=83.0
FX_PINNED_AT=2026-09-20T12:00:00Z

MANDATE_TTL_SECONDS=900
PILOT_AGENT_ID=
PILOT_A2A_URL=

# Offline demo / tests: skip live Anakin, use src/broker/fixtures.
BROKER_OFFLINE=1
# BROKER_WRITE_FIXTURES=1
