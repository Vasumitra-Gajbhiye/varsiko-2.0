# ---------------------------------------------------------------------------
# Severance Pilot — mandate gateway (npm run gateway)
# Never commit real values. Run `npm run keygen` for VAULT_KEY / GATEWAY_BEARER_TOKEN
# suggestions and the key file paths.
# ---------------------------------------------------------------------------
# REQUIRED. What the caller sends as `Authorization: Bearer ...` (32+ chars).
GATEWAY_BEARER_TOKEN=
# OPTIONAL. A SECOND bearer, for the human operator's handoff commands (32+ chars, must
# differ from GATEWAY_BEARER_TOKEN). Nasiko's connector must NOT hold it: it reaches
# handoff_prepare and handoff_register, which render cloud-init and register the address
# the gateway sends the Coolify token and every migrated env var to. Unset = those tools
# are disabled and the handoff lane cannot be used.
GATEWAY_OPERATOR_TOKEN=
# REQUIRED. 32 bytes as 64 hex chars; seals env values and the Coolify token at rest.
VAULT_KEY=
# REQUIRED. Hetzner project API token, Read & Write.
HETZNER_TOKEN=
# REQUIRED. Comma-separated names of SSH keys already uploaded to the Hetzner project.
HETZNER_SSH_KEYS=
# REQUIRED. Ed25519 public key that verifies mandates (from `npm run keygen`).
MANDATE_PUBLIC_KEY_FILE=.local/keys/mandate.pub.pem

# Recommended. Firewall allowing :8000 only from GATEWAY_EGRESS_IP. Without it,
# server creation is refused unless ALLOW_INSECURE_COOLIFY_HTTP=true.
HETZNER_FIREWALL_ID=
ALLOW_INSECURE_COOLIFY_HTTP=false
# Public IP the gateway calls Coolify from; written into Coolify's allowed_ips.
GATEWAY_EGRESS_IP=

# Optional. A missing key disables only the tools that need it.
CLOUDFLARE_TOKEN=
VERCEL_TOKEN=
VERCEL_TEAM_ID=
ANAKIN_API_KEY=
# Verifies the Auditor's PASS token before DNS cutover (from `npm run keygen`).
AUDITOR_PUBLIC_KEY_FILE=.local/keys/auditor.pub.pem

# Optional tuning.
APP_PORT=3000
DATA_DIR=./data
PORT=8787
CLOUD_INIT_TEMPLATE=./cloud-init/coolify.yaml

# ---------------------------------------------------------------------------
# Live driver and preflight (npm run live / preflight)
# ---------------------------------------------------------------------------
# Where the live driver reaches the gateway (direct mode, bypassing Nasiko).
GATEWAY_URL=http://127.0.0.1:8787/mcp

# ---------------------------------------------------------------------------
# A2A agent (npm start) — Nasiko injects these at deploy
# ---------------------------------------------------------------------------
# PILOT_OFFLINE=1 uses FakeProviders; default on Nasiko deploy so the demo cannot spend.
PILOT_OFFLINE=1
# MCP gateway URL Nasiko routes through (namespaced tools + delegation token).
MCP_GATEWAY_URL=
# Same HMAC secret as severance-broker, agent-scoped — verifies cart mandates.
MANDATE_SIGNING_SECRET=
# Optional local override when not running under Nasiko.
NASIKO_AGENT_TOKEN=
