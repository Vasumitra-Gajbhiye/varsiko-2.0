# Secrets — never commit real values.
# nasiko secrets set VERCEL_TOKEN  <token> --agent severance-surveyor
# nasiko secrets set GITHUB_TOKEN  <token> --agent severance-surveyor
VERCEL_TOKEN=
GITHUB_TOKEN=
ANTHROPIC_API_KEY=

# LLM: Nasiko gateway first (injected at deploy). Anthropic is the local fallback.
# OPENAI_BASE_URL=
# OPENAI_API_KEY=
# MCP_GATEWAY_URL=
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
SURVEYOR_MODEL=deepseek-v4-flash
MODEL=deepseek-v4-flash

# Pinned FX — never fetch a live rate. Same vars as the Broker.
FX_USD_INR=83.0
FX_PINNED_AT=2026-09-20T12:00:00Z

# Offline demo / tests: skip live Vercel/GitHub, use fixtures.
SURVEYOR_OFFLINE=1
# SURVEYOR_WRITE_FIXTURES=1
