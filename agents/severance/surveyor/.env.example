# Secrets — never commit real values.
# nasiko secrets set VERCEL_TOKEN  <token> --agent severance-surveyor
# nasiko secrets set GITHUB_TOKEN  <token> --agent severance-surveyor
VERCEL_TOKEN=
GITHUB_TOKEN=

# LLM — required for narration. deploy-nasiko.sh copies OPENAI_API_KEY from
# agents/severance/broker/.env into this container; set it here for local runs.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
SURVEYOR_MODEL=gpt-4o-mini
MODEL=gpt-4o-mini
# MCP_GATEWAY_URL=

# Pinned FX — never fetch a live rate. Same vars as the Broker.
FX_USD_INR=83.0
FX_PINNED_AT=2026-09-20T12:00:00Z

# Offline demo / tests: skip live Vercel/GitHub, use fixtures.
SURVEYOR_OFFLINE=1
# SURVEYOR_WRITE_FIXTURES=1
