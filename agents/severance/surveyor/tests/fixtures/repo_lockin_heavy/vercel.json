{
  "crons": [{ "path": "/api/cron", "schedule": "0 0 * * *" }],
  "rewrites": [{ "source": "/old", "destination": "/new" }],
  "redirects": [{ "source": "/a", "destination": "/b", "permanent": true }],
  "headers": [{ "source": "/(.*)", "headers": [{ "key": "X-Frame-Options", "value": "DENY" }] }],
  "functions": { "api/hello.ts": { "maxDuration": 10, "memory": 1024 } }
}
