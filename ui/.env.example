# Severance UI (python ui/serve.py) — talks to a local Nasiko instance.
# Copy to .env; .env is gitignored by the repo-root rule.
# serve.py DOES auto-load ui/.env. Real environment variables still win.

# Nasiko control plane.
NASIKO_URL=http://localhost:8080
NASIKO_USER=admin
# CHANGE THIS. serve.py falls back to the literal "changeme" when unset.
NASIKO_PASSWORD=

# Ceiling pre-filled in the form. The human can change it per run, and the agents
# never default one of their own.
CEILING_INR_MONTHLY=4200

UI_HOST=127.0.0.1
UI_PORT=8788
