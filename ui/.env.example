# Severance UI (python ui/serve.py) — talks to a local Nasiko instance.
# Copy to .env; .env is gitignored by the repo-root rule.
# serve.py does NOT auto-load this file; export the vars or use a dotenv runner.

# Nasiko control plane.
NASIKO_URL=http://localhost:8080
NASIKO_USER=admin
# CHANGE THIS. serve.py falls back to the literal "changeme" when unset.
NASIKO_PASSWORD=

# Monthly INR ceiling offered in the UI. Never defaulted by the agents themselves.
CEILING_INR_MONTHLY=1500

UI_HOST=127.0.0.1
UI_PORT=8788
