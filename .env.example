# Team-scoped Vercel access token (https://vercel.com/account/tokens).
# Vercel has no read-only scope; the estimator only ever issues GET requests.
VERCEL_TOKEN=
# Optional: needed for /v1/billing/charges when using a Full Account token.
VERCEL_TEAM_ID=
# Optional: lets the estimator read package.json from private GitHub repos.
GITHUB_TOKEN=
